# Only the API project is needed to build the image.
**/bin/
**/obj/
CareerVault.Api.Tests/

# Never put uploaded files, local settings or secrets into an image.
**/App_Data/
**/appsettings.Development.json
**/appsettings.*.local.json
**/*.user
**/.env
**/.env.*
**/*.pfx
**/*.pem

# Editors and OS files
**/.vs/
**/.vscode/
**/.idea/
**/.DS_Store
